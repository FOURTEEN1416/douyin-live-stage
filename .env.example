# 复制成 .env 后填自己的值。已在环境变量里设过的不覆盖。

# ---- 必须 ----
# MiMo 语音合成（限时免费）：https://platform.xiaomimimo.com
MIMO_API_KEY=sk-你的key

# ---- 识图 / 写台词 ----
# Agnes：flash 系列免费，但并发上限只有 1~2 路，且被压测过会降速
AGNES_API_KEY=
# 备用端点（DeepSeek-V4.1-Flash：免费、带视觉、约 13 秒）
# 程序会记住各端点的实测速度，自动把快的排前面，不用手动切
VISION_BASE_URL=https://hk1.meitnru.site/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=DeepSeek-V4.1-Flash-1017

# 注意：MiMo 的对话/视觉模型需要余额（402 会报 Insufficient account balance），
# 只有 TTS 是限时免费。所以上面两项至少填一个能识图的。

# ---- 语音 ----
MIMO_TTS_VOICE=冰糖
# 直播默认风格：松弛、不发力。改之前先听 audio/松_M2_松弛.mp3
# MIMO_TTS_STYLE=声音松弛、不用力的年轻女生，随口说话，语气平，不要刻意咬字。
# MIMO_TTS_MODEL=mimo-v2.5-tts

# ---- 自动旁白 ----
# dual=Agnes 识图 + DeepSeek 写词（默认）｜ single=一次调用搞定
NARRATOR_MODE=dual
# 舞台地址（旁白和弹幕桥都往这里推）
STAGE_URL=http://127.0.0.1:8790

# ---- 弹幕 ----
# 直播间号 = 你的抖音号（数字那串），**开播前就有，永远不变**。
# 在哪看：抖音 App → 我 → 点头像 → 「抖音号：1234567890」；
#         或网页版 live.douyin.com/<这串数字>。
# 每次开播会变的那个长房间号（7700000000000000000）是抖音内部用的，不用管。
# 填了之后 run.py 会自动拉起 tools/douyinLive 抓取服务 + 弹幕桥。
# 开播前启动也没关系：抓取服务每 15 秒重查一次，一开播就自动接上。
DOUYIN_ROOM=
# 弹幕源的 ws 地址，按你用的抓取工具填
# chenwng/douyin-live: ws://127.0.0.1:1088/ws/<房间号>
# DouyinBarrageGrab:   ws://127.0.0.1:8888

# ---- 声音往哪放（重要）----
# 默认由服务端把语音直接播到 VB-Cable 的虚拟声卡，直播伴侣只采
# CABLE Output，观众就只听到大肥鱼，不会混进微信提示音之类的系统声音。
# 设备关键字，能匹配上 "CABLE" 就行（本机实测 "CABLE Input" 打不开，
# 程序会自动退到 "CABLE In 16ch"）
AUDIO_OUT_DEVICE=CABLE
# 1=同时播到扬声器（你自己也能听到）；如果你给 CABLE Input 开了「侦听」，
# 就改成 0，否则会听到两遍
AUDIO_MONITOR=1
